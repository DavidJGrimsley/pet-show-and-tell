{
  "expo": {
    "name": "Pet Show and Tell",
    "slug": "pet-show-and-tell",
    "version": "1.0.0",
    "scheme": "pet-show-and-tell",
    "platforms": [
      "android"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a pet picture to add it to your on-device feed.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash.png",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#000000"
          },
          "imageWidth": 200
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "dark",
          "enforceContrast": false
        }
      ],
      "expo-system-ui"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#e5eee3"
      },
      "backgroundColor": "#f7f5ef"
    },
    "backgroundColor": "#f7f5ef",
    "androidStatusBar": {
      "backgroundColor": "#f7f5ef",
      "barStyle": "dark-content",
      "translucent": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "dark"
      },
      "eas": {
        "projectId": "00ff11f9-a771-44bb-a352-ba497bfea0c7"
      }
    },
    "owner": "mrdj2u"
  }
}
