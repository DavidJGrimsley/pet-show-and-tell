{
  "name": "pet-show-and-tell",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo start --android",
    "ios": "expo start --ios",
    "start": "expo start",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web --clear",
    "export:web": "node ./scripts/export-web.mjs",
    "test:web-smoke": "node ./scripts/smoke-web.mjs",
    "mds:continue": "npx mds continue",
    "mds:doctor": "npx mds doctor",
    "mds:doctor:ci": "npx mds doctor --ci",
    "check:react-doctor": "npx react-doctor -y --no-telemetry",
    "mds:react-doctor": "npx mds run react-doctor",
    "mds:stylist:sync": "npx mds stylist sync .",
    "stylist:sync:android": "node ./scripts/stylist-sync-android.mjs",
    "mds:eject": "npx mds eject .",
    "mds:eject:exposition": "npx mds eject exposition .",
    "mds:eject:stylist": "npx mds eject stylist .",
    "free-port": "npx mds free-port",
    "clear-expo-start": "npx mds clear-expo-start",
    "expo-install-fix": "npx expo install --fix",
    "expo-doctor": "npx expo-doctor",
    "post-create-check": "npx expo install --fix && npx expo-doctor",
    "ci:verify": "npx mds doctor --ci",
    "test:pet-migration": "node --experimental-sqlite scripts/test-pet-migration.cjs",
    "test:web-data": "node scripts/test-pet-web-data.cjs",
    "test": "npm run lint && npm run typecheck && npm run test:pet-migration && npm run test:web-data"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "eslint-config-expo": "~58.0.4",
    "expo": "^58.0.0",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-navigation-bar": "~58.0.4",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.13.0",
    "reanimated-color-picker": "4.2.0",
    "tailwindcss": "^3.4.17",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@mr.dj2u/cli": "^0.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "~19.3.0",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.2.5",
    "react-doctor": "^0.9.12",
    "typescript": "~6.0.3"
  },
  "private": true
}
